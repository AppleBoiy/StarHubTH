{
  "$comment": "Canonical inventory of screenshot-worthy app states — see docs/RELEASE_SCREENSHOTS_PLAN.md Phase 1. Consumed by StarHubTHUITests/Sources/ScreenshotCapture/ScreenshotCaptureTool.swift (Phase 3.1) and scripts/check_screenshot_coverage.py (Phase 3.2, diffs sidebar-tab-* identifiers found in source against 'navigation' entries here, to catch new features that never got added). Tokens like <folderName> in an 'identifier' are resolved at capture time from a local, gitignored targets file — see scripts/screenshot_targets.example.json.",
  "version": 1,
  "screens": [
    {
      "id": "home",
      "feature": "Home",
      "description": "Home dashboard — avatar header, app info, game folder, SMAPI status",
      "tier": "core",
      "navigation": [
        { "action": "click", "identifier": "sidebar-tab-Home" }
      ]
    },
    {
      "id": "updates",
      "feature": "Updates",
      "description": "Software Update / System Alerts screen",
      "tier": "core",
      "precondition": "At least one out-of-date mod or SMAPI error must exist — this row is only visible when alertCount > 0.",
      "navigation": [
        { "action": "click", "identifier": "sidebar-tab-Updates" }
      ]
    },
    {
      "id": "saves-list",
      "feature": "Saves",
      "description": "Saves — Finder-style list/tree view",
      "tier": "core",
      "navigation": [
        { "action": "click", "identifier": "sidebar-tab-Saves" }
      ]
    },
    {
      "id": "saves-grid",
      "feature": "Saves",
      "description": "Saves — grid view",
      "tier": "core",
      "navigation": [
        { "action": "click", "identifier": "sidebar-tab-Saves" },
        { "action": "click", "identifier": "saves-view-mode-grid" }
      ]
    },
    {
      "id": "save-editor",
      "feature": "Saves",
      "description": "Save Editor — avatar, notes, character info, inventory",
      "tier": "core",
      "precondition": "targets.folderName must name a real save in the maintainer's gameDir.",
      "placeholders": ["folderName"],
      "navigation": [
        { "action": "click", "identifier": "sidebar-tab-Saves" },
        { "action": "clickMenuItem", "menuIdentifier": "save-row-menu-<folderName>", "index": 0, "note": "index 0 is 'Save Management' — see SaveRow.swift's Menu item order" }
      ]
    },
    {
      "id": "save-timeline",
      "feature": "Saves",
      "description": "Save Timeline — backup list",
      "tier": "core",
      "precondition": "targets.folderName must name a real save with at least one backup.",
      "placeholders": ["folderName"],
      "navigation": [
        { "action": "click", "identifier": "sidebar-tab-Saves" },
        { "action": "clickMenuItem", "menuIdentifier": "save-row-menu-<folderName>", "index": 1, "note": "index 1 is 'Timeline' — see SaveRow.swift's Menu item order" }
      ]
    },
    {
      "id": "mods-list",
      "feature": "Mods",
      "description": "Mods — list view, enabled/disabled sections",
      "tier": "core",
      "navigation": [
        { "action": "click", "identifier": "sidebar-tab-Mods" }
      ]
    },
    {
      "id": "mods-grid",
      "feature": "Mods",
      "description": "Mods — grid view (ModCardView)",
      "tier": "core",
      "navigation": [
        { "action": "click", "identifier": "sidebar-tab-Mods" },
        { "action": "clickSegment", "identifier": "mods-view-mode-picker", "segmentLabel": "square.grid.2x2" }
      ]
    },
    {
      "id": "mods-group-expanded",
      "feature": "Mods",
      "description": "Mods — group row expanded (multi-file mod, missing-dependency warning)",
      "tier": "core",
      "precondition": "targets.groupFolderName must name a real multi-file/group mod with a missing dependency.",
      "placeholders": ["groupFolderName"],
      "navigation": [
        { "action": "click", "identifier": "sidebar-tab-Mods" },
        { "action": "click", "identifier": "mod-row-<groupFolderName>", "note": "clicking the group row itself toggles expansion" }
      ]
    },
    {
      "id": "mod-detail-description",
      "feature": "Mods",
      "description": "Mod Detail — Description tab",
      "tier": "core",
      "precondition": "targets.folderName's manifest UpdateKeys must resolve to a real Nexus mod for real cover/description data.",
      "placeholders": ["folderName"],
      "navigation": [
        { "action": "click", "identifier": "sidebar-tab-Mods" },
        { "action": "click", "identifier": "mod-row-info-button-<folderName>" }
      ]
    },
    {
      "id": "mod-detail-dependencies",
      "feature": "Mods",
      "description": "Mod Detail — Dependencies tab (dependency graph)",
      "tier": "core",
      "placeholders": ["folderName"],
      "navigation": [
        { "action": "click", "identifier": "sidebar-tab-Mods" },
        { "action": "click", "identifier": "mod-row-info-button-<folderName>" },
        { "action": "clickSegment", "identifier": "mod-detail-tab-picker", "segmentIndex": 2 }
      ]
    },
    {
      "id": "mod-config-editor",
      "feature": "Mods",
      "description": "Mod Config Editor — Visual tab (grouped settings tree)",
      "tier": "core",
      "precondition": "targets.folderName must have a config.json.",
      "placeholders": ["folderName"],
      "navigation": [
        { "action": "click", "identifier": "sidebar-tab-Mods" },
        { "action": "clickDescendant", "rowIdentifier": "mod-row-<folderName>", "descendantLabel": "gearshape", "note": "ModListRow's config-gear button has no identifier of its own — SWIFT_STANDARDS.md §10 documents why (row identifier clobbers descendant identifiers); same lookup ModConfigEditRoundTripUITests already uses." }
      ]
    },
    {
      "id": "profiles-list",
      "feature": "Profiles",
      "description": "Profiles — populated list",
      "tier": "core",
      "precondition": "At least one mod profile must exist.",
      "navigation": [
        { "action": "click", "identifier": "sidebar-tab-Profiles" }
      ]
    },
    {
      "id": "profile-detail",
      "feature": "Profiles",
      "description": "Profile Detail sheet",
      "tier": "core",
      "placeholders": ["profileId"],
      "navigation": [
        { "action": "click", "identifier": "sidebar-tab-Profiles" },
        { "action": "click", "identifier": "profile-row-info-button-<profileId>" }
      ]
    },
    {
      "id": "modpacks-empty",
      "feature": "ModPacks",
      "description": "ModPacks — empty drop-zone / URL import prompt",
      "tier": "core",
      "precondition": "No collection currently imported.",
      "navigation": [
        { "action": "click", "identifier": "sidebar-tab-ModPacks" }
      ]
    },
    {
      "id": "modpacks-imported",
      "feature": "ModPacks",
      "description": "ModPacks — imported collection banner + per-mod rows",
      "tier": "core",
      "precondition": "A real Nexus Collection must already be imported — data precondition, not a navigation gap.",
      "navigation": [
        { "action": "click", "identifier": "sidebar-tab-ModPacks" }
      ]
    },
    {
      "id": "settings",
      "feature": "Settings",
      "description": "Settings — full page",
      "tier": "core",
      "navigation": [
        { "action": "click", "identifier": "sidebar-tab-Settings" }
      ]
    },
    {
      "id": "logs",
      "feature": "Logs",
      "description": "Logs — main list",
      "tier": "core",
      "precondition": "Only visible when @AppStorage(\"showDeveloperLogs\") is true — enable it in Settings first.",
      "navigation": [
        { "action": "click", "identifier": "sidebar-tab-Logs" }
      ]
    },
    {
      "id": "changelog",
      "feature": "Changelog",
      "description": "App Changelog — rendered CHANGELOG.md",
      "tier": "core",
      "navigation": [
        { "action": "click", "identifier": "sidebar-tab-AppChangelog" }
      ]
    },
    {
      "id": "thaihub-list",
      "feature": "ThaiHub",
      "description": "ThaiHub — mod list",
      "tier": "core",
      "navigation": [
        { "action": "click", "identifier": "sidebar-tab-ThaiHub" }
      ]
    },
    {
      "id": "thaihub-detail",
      "feature": "ThaiHub",
      "description": "ThaiHub — mod detail",
      "tier": "core",
      "placeholders": ["modName"],
      "navigation": [
        { "action": "click", "identifier": "sidebar-tab-ThaiHub" },
        { "action": "click", "identifier": "thaihub-row-<modName>", "note": "ThaiTranslationMod.id is its name" }
      ]
    }
  ]
}
